NODE_ENV=production
HOST=127.0.0.1
PORT=4000
DATABASE_URL=mysql://remote_work:generate-a-long-random-password@mysql.internal:3306/remote_work
JWT_ACCESS_SECRET=generate-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=https://manager.example.com
SCREENSHOT_STORAGE_PATH=/var/lib/remote-work/screenshots
METRICS_TOKEN=generate-at-least-24-random-characters
TRUST_PROXY_HOPS=1
API_URL=http://127.0.0.1:4000/api/v1
