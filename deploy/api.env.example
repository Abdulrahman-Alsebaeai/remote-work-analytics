NODE_ENV=production
HOST=127.0.0.1
PORT=4000
DATABASE_URL=mysql://remote_work:replace-password@mysql.internal:3306/remote_work
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=https://manager.example.com
SCREENSHOT_STORAGE_PATH=/var/lib/remote-work/screenshots
METRICS_TOKEN=replace-with-at-least-24-random-characters
TRUST_PROXY_HOPS=1
