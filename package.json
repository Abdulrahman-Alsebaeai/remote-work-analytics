{
  "name": "remote-work-analytics",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "dependencies": { "dotenv": "^17.2.3", "prisma": "^6.19.3" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run start:dev -w @remote-work/api",
    "dev:web": "npm run dev -w @remote-work/web",
    "test": "npm run test -w @remote-work/api",
    "lint": "npm run lint -w @remote-work/api",
    "db:generate": "npm run db:generate -w @remote-work/api",
    "db:migrate": "npm run db:migrate -w @remote-work/api",
    "db:seed": "npm run db:seed -w @remote-work/api"
  },
  "engines": { "node": ">=20" },
  "overrides": { "next": { "postcss": "8.5.25", "sharp": "0.35.3" } }
}
